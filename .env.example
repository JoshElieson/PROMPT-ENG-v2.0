# GitHub OAuth App (enable "Device Authorization Flow" in app settings)
# https://github.com/settings/applications/new
VITE_GITHUB_CLIENT_ID=your_github_oauth_client_id

# AI provider API keys (desktop app / Tauri backend)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

