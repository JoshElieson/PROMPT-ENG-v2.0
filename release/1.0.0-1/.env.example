# GitHub OAuth App (enable "Device Authorization Flow" in app settings)
# https://github.com/settings/applications/new
VITE_GITHUB_CLIENT_ID=your_github_oauth_client_id

# AI provider API keys (desktop app / Tauri backend)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROK_API_KEY=
# XAI_API_KEY= # optional alias for GROK_API_KEY

# Optional provider overrides
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# XAI_BASE_URL=https://api.x.ai/v1
# OPENAI_MODEL=gpt-4o
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# GEMINI_MODEL=gemini-1.5-pro
# DEEPSEEK_MODEL=deepseek-chat
# XAI_MODEL=grok-4.3
# Optional: grok-4.20-0309-non-reasoning, grok-4.20-0309-reasoning, grok-build-0.1 (see GET /v1/language-models)
