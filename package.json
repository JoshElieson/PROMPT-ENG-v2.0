{
  "name": "forge",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/tauri-dev.ps1",
    "release:beta": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/release-beta.ps1",
    "release:managed": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/release-managed.ps1",
    "release:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/release-beta.ps1 -AllowLocalKeys",
    "backend:token": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/new-backend-token.ps1",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
